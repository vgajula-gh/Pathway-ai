{
  "name": "pathway-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Pathway AI — an AI companion that helps high school students get more out of their high school years.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "db:setup": "npm run db:push --workspace apps/api && npm run db:seed --workspace apps/api",
    "db:sync:replit": "node scripts/sync-replit-development-schema.mjs",
    "test": "npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "build": "node scripts/prisma-production.mjs && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "setup": "node scripts/setup.mjs",
    "db:demo": "npm run db:demo --workspace apps/api",
    "cleanup:samples": "node --import tsx scripts/cleanup-samples.mjs",
    "check:extraction": "node --env-file-if-exists=.env --import tsx scripts/check-extraction.mjs",
    "ollama:setup": "node scripts/setup-ollama.mjs",
    "ollama:start": "node scripts/start-ollama.mjs",
    "start": "node scripts/start-production.mjs",
    "demo:workflows": "npm run demo:workflows --workspace apps/api --",
    "check:scout": "node --env-file-if-exists=.env scripts/check-scout.mjs",
    "pilot:reset": "node --env-file-if-exists=.env scripts/pilot-reset.mjs",
    "check:growth": "node --env-file-if-exists=.env --import tsx scripts/check-growth-readiness.mjs",
    "eval:explore": "node scripts/eval-explore.mjs",
    "eval:explore:live": "node --env-file-if-exists=.env scripts/eval-explore.mjs --live",
    "eval:explore:compare": "node --import tsx scripts/compare-explore-evals.ts",
    "typecheck:evals": "tsc -p apps/api/tsconfig.evals.json",
    "check:knowledge": "node --env-file-if-exists=.env scripts/check-knowledge.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
