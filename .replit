modules = ["web", "nodejs-22", "postgresql-16"]
run = "npm run dev"

[deployment]
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8787
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_URL='file:./dev.db' VITE_PORT=5000 WEB_ORIGIN=\"https://${REPLIT_DEV_DOMAIN}\" npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
