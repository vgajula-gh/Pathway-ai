{
  "name": "Pathway AI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "node scripts/setup-codespace.mjs",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Pathway AI",
      "onAutoForward": "openBrowser"
    },
    "11434": {
      "label": "Ollama (internal only)",
      "onAutoForward": "ignore"
    }
  },
  "remoteEnv": {
    "USE_OLLAMA": "${localEnv:USE_OLLAMA:true}"
  },
  "postStartCommand": "node scripts/start-ollama.mjs"
}
