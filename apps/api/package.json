{
  "name": "@pathway/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node ../../scripts/start-production.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "prisma generate --schema prisma/schema.prisma && vitest run",
    "db:push": "node --env-file=../../.env ../../node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:demo": "tsx --env-file=../../.env prisma/demo.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.5.0",
    "node-ical": "^0.26.1",
    "openai": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
