# ---- API ----
PORT=8787
# SQLite for local dev (a file on your computer; nothing to buy)
DATABASE_URL="file:./dev.db"
# Which AI powers Buddy: "anthropic" (Claude), "openai", or "ollama"
LLM_PROVIDER=anthropic
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI key from https://platform.openai.com (set OPENAI_MODEL to a current model id)
OPENAI_API_KEY=
OPENAI_MODEL=
# Local AI in Codespaces (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Allowed browser address
WEB_ORIGIN=http://localhost:5173
# Set to "true" to run without any AI key
AI_DISABLED=false

# ---- WEB ----
# Empty uses the web address and Vite's /api proxy in development.
VITE_API_URL=


# News ingestion: empty disables fetching; enable only after live/terms validation.
# Supported first sources: nasa,nsf. No student data is sent to sources.
NEWS_SOURCE_IDS=
