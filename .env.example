# ---- API ----
PORT=8787
# SQLite for local dev (a file on your computer; nothing to buy)
DATABASE_URL="file:./dev.db"
# Which AI powers Buddy: "anthropic" (Claude) or "openai"
LLM_PROVIDER=anthropic
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI key from https://platform.openai.com (set OPENAI_MODEL to a current model id)
OPENAI_API_KEY=
OPENAI_MODEL=
# Allowed browser address
WEB_ORIGIN=http://localhost:5173
# Set to "true" to run without any AI key
AI_DISABLED=false

# ---- WEB ----
VITE_API_URL=http://localhost:8787
