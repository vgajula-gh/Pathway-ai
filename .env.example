# ---- API ----
PORT=8787
# Enable labeled sample opportunities and calendars only for an intentional demo.
DEMO_MODE=false
# SQLite for local dev (a file on your computer; nothing to buy)
DATABASE_URL="file:./dev.db"
# Which AI powers Buddy: "anthropic" (Claude), "openai", or "ollama"
LLM_PROVIDER=anthropic
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI key from https://platform.openai.com (set OPENAI_MODEL to a current model id)
OPENAI_API_KEY=
OPENAI_MODEL=
# Local AI in Codespaces (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Allowed browser address
WEB_ORIGIN=http://localhost:5173
# Set to "true" to run without any AI key
AI_DISABLED=false

# ---- WEB ----
# Empty uses the web address and Vite's /api proxy in development.
VITE_API_URL=

# Tester gate (required in production; comma-separated, case-sensitive)
ACCESS_CODES=
# AI feature requests per student per UTC day and across everyone per UTC month.
# 0 disables new AI requests. Defaults: daily 20, monthly 1000.
AI_DAILY_LIMIT=20
AI_MONTHLY_LIMIT=1000
# Optional external feedback form (http or https)
FEEDBACK_URL=

# Encrypt private calendar URLs. Required to link calendars in production.
# Generate 32 random bytes (hex), keep stable across deploys and back up securely.
CALENDAR_SECRET=

# Web Push (optional; nudges are off by default)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Private sign-in phrases: required in production, at least 32 random characters.
# Keep this value stable across deploys and instances. Never put it in VITE_* variables.
SIGN_IN_SECRET=

# Shared opportunity discovery is optional and off until explicitly enabled.
DISCOVERY_ENABLED=false
SEARCH_PROVIDER=none
# OpenAI search defaults to gpt-4.1-mini; Anthropic inherits ANTHROPIC_MODEL.
# Choose a web-search-capable model currently available to your provider account.
SEARCH_MODEL=
# Separate from Buddy's OPENAI_MODEL/ANTHROPIC_MODEL; blank inherits Buddy's model.
AI_MODEL_EXTRACTION=
EMBEDDING_PROVIDER=none
# Defaults: OpenAI text-embedding-3-small (1536), Pinecone multilingual-e5-large (1024),
# Voyage voyage-3-lite (512), Ollama nomic-embed-text (768).
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Safe local default; set pinecone explicitly for production.
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX=
VOYAGE_API_KEY=
DISCOVERY_MONTHLY_BUDGET=10
DISCOVERY_RECHECKS_PER_MONTH=10
# Optional owner-reviewed official organizer domains, comma separated. No protocols/paths.
DISCOVERY_TRUSTED_DOMAINS=
# Protects POST /internal/jobs/run; generate a separate random value >=32 characters.
JOBS_SECRET=
MANUAL_REFRESHES_PER_MONTH=1
FREE_PICKS=3
PAID_PICKS=3
STRETCH_PICKS=1
REFRESH_INTERVAL_DAYS=30
