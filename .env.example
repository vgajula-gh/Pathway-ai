# ---- API ----
PORT=8787
# Enable labeled sample opportunities and calendars only for an intentional demo.
DEMO_MODE=false
# SQLite for local dev (a file on your computer; nothing to buy)
DATABASE_URL="file:./dev.db"
# Which AI powers Buddy: "anthropic" (Claude), "openai", or "ollama"
LLM_PROVIDER=anthropic
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI key from https://platform.openai.com (set OPENAI_MODEL to a current model id)
OPENAI_API_KEY=
OPENAI_MODEL=
# Local AI in Codespaces (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Allowed browser address
WEB_ORIGIN=http://localhost:5173
# Set to "true" to run without any AI key
AI_DISABLED=false

# ---- WEB ----
# Empty uses the web address and Vite's /api proxy in development.
VITE_API_URL=

# Tester gate (required in production; comma-separated, case-sensitive)
ACCESS_CODES=
# AI feature requests per student per UTC day and across everyone per UTC month.
# 0 disables new AI requests. Defaults: daily 20, monthly 1000.
AI_DAILY_LIMIT=20
AI_MONTHLY_LIMIT=1000
# Optional external feedback form (http or https)
FEEDBACK_URL=

# Encrypt private calendar URLs. Required to link calendars in production.
# Generate 32 random bytes (hex), keep stable across deploys and back up securely.
CALENDAR_SECRET=

# Web Push (optional; nudges are off by default)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Private sign-in phrases: required in production, at least 32 random characters.
# Keep this value stable across deploys and instances. Never put it in VITE_* variables.
SIGN_IN_SECRET=

# Shared opportunity discovery is optional and off until explicitly enabled.
DISCOVERY_ENABLED=false
SEARCH_PROVIDER=none
# OpenAI search defaults to gpt-4.1-mini; Anthropic inherits ANTHROPIC_MODEL.
# Choose a web-search-capable model currently available to your provider account.
SEARCH_MODEL=
# Separate from Buddy's OPENAI_MODEL/ANTHROPIC_MODEL; blank inherits Buddy's model.
AI_MODEL_EXTRACTION=
EMBEDDING_PROVIDER=none
# Defaults: OpenAI text-embedding-3-small (1536), Pinecone multilingual-e5-large (1024),
# Voyage voyage-3-lite (512), Ollama nomic-embed-text (768).
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Safe default in every environment; set pinecone explicitly for durable production vectors.
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX=
VOYAGE_API_KEY=
DISCOVERY_MONTHLY_BUDGET=10
# Shared source rechecks AND standalone knowledge preparation attempts/month.
DISCOVERY_RECHECKS_PER_MONTH=10
# Optional owner-reviewed official organizer domains, comma separated. No protocols/paths.
DISCOVERY_TRUSTED_DOMAINS=
# Protects owner jobs and diagnostics; generate a separate random value >=32 characters.
JOBS_SECRET=
# Searches with usable results only; failed/empty attempts preserve the student allowance.
MANUAL_REFRESHES_PER_MONTH=1
FREE_PICKS=3
PAID_PICKS=3
STRETCH_PICKS=1
REFRESH_INTERVAL_DAYS=30

# Opportunity Scout overrides (optional; no extra provider key).
# Blank inherits SEARCH_MODEL, then the provider's existing search default.
AI_MODEL_SCOUT=
# Default: research facts + a best-effort page confirmation, no extraction AI call.
# Optional compatibility mode: fetch_and_extract.
SCOUT_SOURCE_MODE=research_evidence
# Default two funded research batches; hard ceiling three. Up to three focus topics/batch.
SCOUT_MAX_CALLS_PER_SEARCH=2
# Web tools inside each research call: default five, maximum ten.
SCOUT_MAX_TOOL_CALLS=5
# Combined enrichment pool, maximum sixteen. Cost hints only order the pool.
SCOUT_FREE_CANDIDATES=8
SCOUT_PAID_CANDIDATES=8
SCOUT_CACHE_DAYS=30
SCOUT_TIMEOUT_SECONDS=60
SCOUT_RESEARCH_TIMEOUT_SECONDS=150
SCOUT_EXTRACTION_TIMEOUT_SECONDS=90
SCOUT_MAX_OUTPUT_TOKENS=6000
# Includes robots requests, redirects and supporting pages.
SCOUT_MAX_HTTP_ATTEMPTS=40
# Optional explicit application/redirect domains. A .org suffix alone is not trusted.
SCOUT_REDIRECT_DOMAINS=
# Estimated discovery spending cap. This is separate from request-count limits.
# Existing usage is preserved; pending runs reserve funds. Provider billing differs.
DISCOVERY_MONTHLY_SPEND_USD=25
# Owner-configured estimates, NOT verified current vendor prices. Use rates
# conservative enough for all configured research/repair/extraction models.
SCOUT_WEB_SEARCH_PRICE_USD=0.025
SCOUT_INPUT_PRICE_PER_MILLION=4
SCOUT_OUTPUT_PRICE_PER_MILLION=16
# Optional JSON object, all six non-negative weights must total 100.
# Invalid weights fall back to defaults and are flagged in owner diagnostics.
SCOUT_SCORE_WEIGHTS={"interest":30,"urgency":20,"build":15,"location":15,"time":10,"confidence":10}
